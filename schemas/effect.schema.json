{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank-tycoon.example/schemas/effect.schema.json",
  "title": "Safe Mod Effect",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "operation", "value"],
  "properties": {
    "target": {"type": "string", "enum": ["staff.productivity_bps", "service.teller_duration_bps", "customer.deposit_growth_bps", "bank.reputation_points", "loan.default_risk_bps", "liquidity.required_buffer_bps"]},
    "operation": {"type": "string", "enum": ["add", "multiply", "set", "unlock", "modify_chance"]},
    "value": {"type": ["integer", "string", "boolean"]},
    "scope": {"type": "string", "enum": ["global", "department", "service", "customer_group"]}
  }
}
