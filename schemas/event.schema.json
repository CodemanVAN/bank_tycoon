{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank-tycoon.example/schemas/event.schema.json",
  "title": "Event Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title_key",
    "description_key",
    "weight",
    "cooldown_days",
    "conditions",
    "options"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_.-]+$"
    },
    "title_key": {
      "type": "string",
      "minLength": 1
    },
    "description_key": {
      "type": "string",
      "minLength": 1
    },
    "weight": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "cooldown_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3650
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "day_at_least",
              "department_exists",
              "policy_adopted",
              "metric_above",
              "cooldown_elapsed"
            ]
          },
          "value": {}
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label_key",
          "effects"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label_key": {
            "type": "string"
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/effect"
            }
          },
          "next_event_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "effect": {
      "title": "Safe Mod Effect",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "operation",
        "value"
      ],
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "staff.productivity_bps",
            "service.teller_duration_bps",
            "customer.deposit_growth_bps",
            "bank.reputation_points",
            "loan.default_risk_bps",
            "liquidity.required_buffer_bps"
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "add",
            "multiply",
            "set",
            "unlock",
            "modify_chance"
          ]
        },
        "value": {
          "type": [
            "integer",
            "string",
            "boolean"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "global",
            "department",
            "service",
            "customer_group"
          ]
        }
      }
    }
  }
}
