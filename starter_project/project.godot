; Bank Tycoon - Godot starter shell
; Target engine: Godot 4.7.2 Stable
; This is a bootstrap project, not a playable prototype.

config_version=5

[application]

config/name="Bank Tycoon"
config/description="A 2D pixel-art bank management simulation."
run/main_scene="res://scenes/boot/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameSession="*res://scripts/autoload/game_session.gd"
ContentRegistry="*res://scripts/autoload/content_registry.gd"
SaveService="*res://scripts/autoload/save_service.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
